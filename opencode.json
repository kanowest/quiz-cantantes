{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": { "*": "allow", ".env": "deny", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "bash": { "*": "ask", "git *": "allow", "npm *": "allow", "ls *": "allow", "mkdir *": "allow", "pwd": "allow", "which *": "allow", "echo *": "allow" }
  },
  "agent": {
    "general": {
      "permission": {
        "bash": { "*": "allow", "*.env*": "deny" }
      }
    }
  }
}
